{
  "mcpServers": {
    "iwas": {
      "url": "https://getiwas.com/mcp",
      "auth": {
        "CLIENT_ID": "${CLIENT_ID}",
        "CLIENT_SECRET": "${CLIENT_SECRET}",
        "scopes": [
          "diagnostics:read",
          "diagnostics:write",
          "session:read",
          "analytics:read",
          "package:read",
          "blog:read",
          "blog:write",
          "blog:publish",
          "offline_access"
        ]
      }
    }
  }
}
